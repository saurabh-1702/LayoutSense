{#- Shared macros. Every piece of content is wrapped in an element carrying
    data-field="<path>" so the renderer can build the answer key from the DOM.
    Direct children of a .flow must be .blk elements (unit of pagination).
    .keep = keep with the next block (headings, entry headers). -#}

{% macro F(path, text, cls='', tag='span') -%}
<{{tag}} data-field="{{ path }}"{% if cls %} class="{{ cls }}"{% endif %}>{{ text }}</{{tag}}>
{%- endmacro %}

{% macro H(sec, s, cls='sh', icon='') -%}
<div class="blk keep {{ cls }}" data-group="sec_{{ sec }}">{{ icon|safe }}<span data-field="heading.{{ sec }}">{{ s.h[sec] }}</span></div>
{%- endmacro %}

{% macro BUL(path, text, s, sec) -%}
<div class="blk bl" data-group="sec_{{ sec }}"><span class="bm">{{ s.bullet }}</span><span data-field="{{ path }}">{{ text }}</span></div>
{%- endmacro %}

{# ---------------- experience ---------------- #}
{% macro exp_head(e, i, s, v, sec='experience') -%}
{% set P = 'experience.' ~ i %}
<div class="blk keep eh" data-group="sec_{{ sec }}">
{%- if v == 'title_first' %}
  <div class="row"><span class="t1">{{ F(P~'.title', e.title) }}</span><span class="dt nw">{{ F(P~'.dates', e.dates) }}</span></div>
  <div class="row r2"><span class="t2">{{ F(P~'.company', e.company) }}{% if e.location and s.show_loc %}<span class="sp">{{ s.sep2 }}</span>{{ F(P~'.location', e.location) }}{% endif %}</span></div>
{%- elif v == 'company_first' %}
  <div class="row"><span class="t1">{{ F(P~'.company', e.company) }}</span>{% if e.location and s.show_loc %}<span class="lc nw">{{ F(P~'.location', e.location) }}</span>{% endif %}</div>
  <div class="row r2"><span class="t2 it">{{ F(P~'.title', e.title) }}</span><span class="dt nw">{{ F(P~'.dates', e.dates) }}</span></div>
{%- elif v == 'inline' %}
  <div class="t1">{{ F(P~'.title', e.title) }}<span class="sp">{{ s.sep2 }}</span>{{ F(P~'.company', e.company) }}{% if e.location and s.show_loc %}<span class="sp">, </span>{{ F(P~'.location', e.location) }}{% endif %}</div>
  <div class="dt2">{{ F(P~'.dates', e.dates) }}</div>
{%- elif v == 'stack' %}
  <div class="dt2">{{ F(P~'.dates', e.dates) }}</div>
  <div class="t1">{{ F(P~'.title', e.title) }}</div>
  <div class="t2">{{ F(P~'.company', e.company) }}{% if e.location and s.show_loc %}<span class="sp"> | </span>{{ F(P~'.location', e.location) }}{% endif %}</div>
{%- endif %}
</div>
{%- endmacro %}

{% macro exp_all(p, s, v, sec='experience') -%}
{% if p.experience %}{{ H(sec, s) }}
{% for e in p.experience %}{% set i = loop.index0 %}{{ exp_head(e, i, s, v, sec) }}
{% for b in e.bullets %}{{ BUL('experience.'~i~'.bullets.'~loop.index0, b, s, sec) }}{% endfor %}
{% endfor %}{% endif %}
{%- endmacro %}

{# ---------------- education ---------------- #}
{% macro edu_one(e, i, s, v) -%}
{% set P = 'education.' ~ i %}
<div class="blk ed" data-group="sec_education">
{%- if v == 'degree_first' %}
  <div class="row"><span class="t1">{{ F(P~'.degree', e.degree) }}</span><span class="dt nw">{{ F(P~'.dates', e.dates) }}</span></div>
  <div class="t2">{{ F(P~'.institution', e.institution) }}{% if e.location and s.show_loc %}<span class="sp">, </span>{{ F(P~'.location', e.location) }}{% endif %}</div>
  {% if e.grade %}<div class="gr">{{ F(P~'.grade', e.grade) }}</div>{% endif %}
{%- elif v == 'inst_first' %}
  <div class="row"><span class="t1">{{ F(P~'.institution', e.institution) }}</span>{% if e.location and s.show_loc %}<span class="lc nw">{{ F(P~'.location', e.location) }}</span>{% endif %}</div>
  <div class="row r2"><span class="t2 it">{{ F(P~'.degree', e.degree) }}{% if e.grade %}<span class="sp">{{ s.sep2 }}</span>{{ F(P~'.grade', e.grade) }}{% endif %}</span><span class="dt nw">{{ F(P~'.dates', e.dates) }}</span></div>
{%- else %}
  <div class="t1">{{ F(P~'.degree', e.degree) }}</div>
  <div class="t2">{{ F(P~'.institution', e.institution) }}</div>
  <div class="dt2">{{ F(P~'.dates', e.dates) }}{% if e.grade %}<span class="sp"> | </span>{{ F(P~'.grade', e.grade) }}{% endif %}</div>
{%- endif %}
</div>
{%- endmacro %}

{% macro edu_all(p, s, v) -%}
{% if p.education %}{{ H('education', s) }}
{% for e in p.education %}{{ edu_one(e, loop.index0, s, v) }}{% endfor %}{% endif %}
{%- endmacro %}

{# ---------------- skills ---------------- #}
{% macro skills_all(p, s, mode, sep=', ') -%}
{% if p.skills %}{{ H('skills', s) }}
{%- if mode == 'grouped' %}
{% for g in p.skill_groups %}<div class="blk skl" data-group="sec_skills"><b data-field="skill_group.{{ loop.index0 }}">{{ g.name }}:</b> {% for k in g.idx %}{{ F('skills.'~k, p.skills[k]) }}{% if not loop.last %}{{ sep }}{% endif %}{% endfor %}</div>{% endfor %}
{%- elif mode == 'inline' %}
<div class="blk skl" data-group="sec_skills">{% for k in p.skills %}{{ F('skills.'~loop.index0, k) }}{% if not loop.last %}{{ sep }}{% endif %}{% endfor %}</div>
{%- elif mode == 'tags' %}
<div class="blk tags" data-group="sec_skills">{% for k in p.skills %}{{ F('skills.'~loop.index0, k, 'tag') }}{% endfor %}</div>
{%- elif mode == 'list' %}
{% for k in p.skills %}{{ BUL('skills.'~loop.index0, k, s, 'skills') }}{% endfor %}
{%- elif mode == 'cols' %}
<div class="blk scol" data-group="sec_skills">{% for k in p.skills %}<div class="bl"><span class="bm">{{ s.bullet }}</span>{{ F('skills.'~loop.index0, k) }}</div>{% endfor %}</div>
{%- elif mode == 'bars' %}
{% for k in p.skills %}<div class="blk sbar" data-group="sec_skills">{{ F('skills.'~loop.index0, k, 'sn') }}<div class="bar"><i style="width:{{ p.skill_levels[loop.index0]*20 }}%"></i></div></div>{% endfor %}
{%- elif mode == 'dots' %}
{% for k in p.skills %}{% set lv = p.skill_levels[loop.index0] %}<div class="blk sdot" data-group="sec_skills">{{ F('skills.'~loop.index0, k, 'sn') }}<span class="dots">{% for d in range(5) %}<i class="{{ 'on' if d < lv else '' }}"></i>{% endfor %}</span></div>{% endfor %}
{%- endif %}
{% endif %}
{%- endmacro %}

{# ---------------- projects ---------------- #}
{% macro proj_all(p, s, v='block') -%}
{% if p.projects %}{{ H('projects', s) }}
{% for pr in p.projects %}{% set P = 'projects.' ~ loop.index0 %}
<div class="blk pj" data-group="sec_projects">
  <div class="row"><span class="t1">{{ F(P~'.name', pr.name) }}</span>{% if pr.dates %}<span class="dt nw">{{ F(P~'.dates', pr.dates) }}</span>{% endif %}</div>
  <div class="pd">{{ F(P~'.description', pr.description) }}</div>
  {% if pr.tech %}<div class="tech"><span class="lbl">{{ s.tech_label }}</span> {{ F(P~'.tech', pr.tech) }}</div>{% endif %}
</div>{% endfor %}{% endif %}
{%- endmacro %}

{# ---------------- certifications / awards ---------------- #}
{% macro cert_all(p, s, v='line') -%}
{% if p.certifications %}{{ H('certifications', s) }}
{% for c in p.certifications %}{% set P = 'certifications.' ~ loop.index0 %}
{%- if v == 'line' %}
<div class="blk bl ci" data-group="sec_certifications"><span class="bm">{{ s.bullet }}</span><span>{{ F(P~'.name', c.name, 'b') }}<span class="sp"> – </span>{{ F(P~'.issuer', c.issuer) }}<span class="sp"> (</span>{{ F(P~'.year', c.year) }}<span class="sp">)</span></span></div>
{%- else %}
<div class="blk ci2" data-group="sec_certifications"><div class="t1s">{{ F(P~'.name', c.name) }}</div><div class="muted sm">{{ F(P~'.issuer', c.issuer) }}<span class="sp">, </span>{{ F(P~'.year', c.year) }}</div></div>
{%- endif %}{% endfor %}{% endif %}
{%- endmacro %}

{% macro award_all(p, s, v='line') -%}
{% if p.awards %}{{ H('awards', s) }}
{% for a in p.awards %}{% set P = 'awards.' ~ loop.index0 %}
{%- if v == 'line' %}
<div class="blk bl ai" data-group="sec_awards"><span class="bm">{{ s.bullet }}</span><span>{{ F(P~'.name', a.name, 'b') }}{% if a.issuer %}<span class="sp">, </span>{{ F(P~'.issuer', a.issuer) }}{% endif %}<span class="sp"> (</span>{{ F(P~'.year', a.year) }}<span class="sp">)</span></span></div>
{%- else %}
<div class="blk ci2" data-group="sec_awards"><div class="t1s">{{ F(P~'.name', a.name) }}</div><div class="muted sm">{% if a.issuer %}{{ F(P~'.issuer', a.issuer) }}<span class="sp">, </span>{% endif %}{{ F(P~'.year', a.year) }}</div></div>
{%- endif %}{% endfor %}{% endif %}
{%- endmacro %}

{# ---------------- languages ---------------- #}
{% macro lang_all(p, s, v='inline') -%}
{% if p.languages %}{{ H('languages', s) }}
{%- if v == 'inline' %}
<div class="blk lg" data-group="sec_languages">{% for l in p.languages %}{% set P = 'languages.' ~ loop.index0 %}{{ F(P~'.language', l.language) }} ({{ F(P~'.proficiency', l.proficiency) }}){% if not loop.last %}{{ s.lang_sep }}{% endif %}{% endfor %}</div>
{%- elif v == 'list' %}
{% for l in p.languages %}{% set P = 'languages.' ~ loop.index0 %}<div class="blk row lgi" data-group="sec_languages">{{ F(P~'.language', l.language, 'b') }}<span class="muted">{{ F(P~'.proficiency', l.proficiency) }}</span></div>{% endfor %}
{%- elif v == 'bars' %}
{% for l in p.languages %}{% set P = 'languages.' ~ loop.index0 %}<div class="blk sbar" data-group="sec_languages"><div class="row">{{ F(P~'.language', l.language, 'sn') }}<span class="sm">{{ F(P~'.proficiency', l.proficiency) }}</span></div><div class="bar"><i style="width:{{ l.level*20 }}%"></i></div></div>{% endfor %}
{%- endif %}{% endif %}
{%- endmacro %}

{# ---------------- contact / links ---------------- #}
{% macro contact_line(p, s) -%}
{%- set items = [] -%}
<span class="ci-i">{{ F('contact.location', p.contact.location) }}</span><span class="sp">{{ s.sep }}</span><span class="ci-i nw">{{ F('contact.phone', p.contact.phone) }}</span><span class="sp">{{ s.sep }}</span><span class="ci-i nw">{{ F('contact.email', p.contact.email) }}</span>{% for k in p.links %}<span class="sp">{{ s.sep }}</span><span class="ci-i nw">{{ F('links.'~loop.index0~'.url', k.url) }}</span>{% endfor %}
{%- endmacro %}

{% macro links_all(p, s, v='list', heading=True) -%}
{% if p.links %}{% if heading %}{{ H('links', s) }}{% endif %}
{% for k in p.links %}<div class="blk lk" data-group="sec_links">{% if v == 'labeled' %}<span class="lbl">{{ k.type }}: </span>{% endif %}{{ F('links.'~loop.index0~'.url', k.url, 'brk') }}</div>{% endfor %}{% endif %}
{%- endmacro %}

{# simple inline svg icons (no text) #}
{% macro ic(name, c='currentColor', sz=12) -%}
<svg class="ic" width="{{ sz }}" height="{{ sz }}" viewBox="0 0 24 24" fill="{{ c }}" aria-hidden="true">
{%- if name == 'mail' %}<path d="M2 5h20v14H2z" fill="none" stroke="{{ c }}" stroke-width="2"/><path d="M2 6l10 7 10-7" fill="none" stroke="{{ c }}" stroke-width="2"/>
{%- elif name == 'phone' %}<path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 013 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/>
{%- elif name == 'pin' %}<path d="M12 2a7 7 0 00-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 00-7-7zm0 9.5A2.5 2.5 0 1112 6a2.5 2.5 0 010 5.5z"/>
{%- elif name == 'link' %}<path d="M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1" fill="none" stroke="{{ c }}" stroke-width="2"/><path d="M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1" fill="none" stroke="{{ c }}" stroke-width="2"/>
{%- elif name == 'brief' %}<path d="M9 3h6v3h6v14H3V6h6zm2 0v3h2V3z"/>
{%- elif name == 'cap' %}<path d="M12 3L1 9l11 6 9-4.9V17h2V9zM5 13.2v4L12 21l7-3.8v-4L12 17z"/>
{%- elif name == 'star' %}<path d="M12 2l3 7h7l-5.6 4.3L18.5 21 12 16.8 5.5 21l2.1-7.7L2 9h7z"/>
{%- elif name == 'globe' %}<circle cx="12" cy="12" r="9" fill="none" stroke="{{ c }}" stroke-width="2"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" fill="none" stroke="{{ c }}" stroke-width="2"/>
{%- elif name == 'cog' %}<circle cx="12" cy="12" r="4"/><path d="M11 1h2v4h-2zM11 19h2v4h-2zM1 11h4v2H1zM19 11h4v2h-4z"/>
{%- elif name == 'badge' %}<circle cx="12" cy="9" r="6"/><path d="M8 14l-2 8 6-3 6 3-2-8z"/>
{%- elif name == 'code' %}<path d="M8 6l-6 6 6 6M16 6l6 6-6 6" fill="none" stroke="{{ c }}" stroke-width="2.4"/>
{%- elif name == 'user' %}<circle cx="12" cy="8" r="4.5"/><path d="M3 22c0-5 4-8 9-8s9 3 9 8z"/>
{%- endif -%}
</svg>
{%- endmacro %}
