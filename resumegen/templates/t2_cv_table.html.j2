{% import '_m.j2' as m %}<!doctype html><html><head><meta charset="utf-8"><style>
{% include '_base.css.j2' %}
.page{padding:{{ s.mt }}px {{ s.mx - 6 }}px {{ s.mb }}px;display:flex;flex-direction:column}
.flow{flex:1}
.cv{display:grid;grid-template-columns:{{ s.lcol }}px 1fr;column-gap:16px}
.cv>.l{text-align:right;color:{{ s.accent }};font-size:.9em;padding-top:.08em}
.cv>.r{min-width:0}
.rule .cv{padding:2px 0;border-bottom:1px solid #e3e3e3}
.secrow{margin-top:{{ s.sec_gap + 4 }}px;margin-bottom:3px}
.secrow .l{font-family:{{ s.head_font|safe }};font-weight:700;color:{{ s.accent }};font-size:1.02em;letter-spacing:.5px;padding-top:0}
.secrow .r{border-bottom:1px solid {{ s.accent }};margin-bottom:.55em}
.nmrow .r{font-family:{{ s.head_font|safe }};font-size:{{ s.name_fs }}px;font-weight:700;line-height:1.1;color:{{ s.name_color }}}
.hlrow .r{font-size:1.1em;color:{{ s.muted }};margin-bottom:6px}
.hd .cv{margin:1px 0}
.hd .l{color:{{ s.muted }}}
.ent{margin-top:5px}
.bl{margin:1px 0}
.sm{font-size:.9em}
</style></head><body>
{% macro sec(name) -%}<div class="blk keep cv secrow" data-group="sec_{{ name }} tbl_{{ name }}"><div class="l" data-field="heading.{{ name }}">{{ s.h[name] }}</div><div class="r"></div></div>{%- endmacro %}
<div class="page{{ ' rule' if s.icons else '' }}" data-page="1">
  <div class="hd p1only" data-region="header">
    <div class="cv nmrow"><div class="l">{{ s.pi_label }}</div><div class="r">{{ m.F('name', p.name|upper if s.name_upper else p.name) }}</div></div>
    {% if s.show_headline %}<div class="cv hlrow"><div class="l"></div><div class="r">{{ m.F('headline', p.headline) }}</div></div>{% endif %}
    <div class="cv"><div class="l">{{ 'Address' if s.edu_v == 'stack' else 'Location' }}</div><div class="r">{{ m.F('contact.location', p.contact.location) }}</div></div>
    <div class="cv"><div class="l">{{ 'Mobile' if s.icons else 'Telephone' }}</div><div class="r">{{ m.F('contact.phone', p.contact.phone) }}</div></div>
    <div class="cv"><div class="l">{{ 'E-mail' if s.icons else 'Email' }}</div><div class="r">{{ m.F('contact.email', p.contact.email, 'brk') }}</div></div>
    {% for k in p.links %}<div class="cv"><div class="l">{{ k.type }}</div><div class="r">{{ m.F('links.'~loop.index0~'.url', k.url, 'brk') }}</div></div>{% endfor %}
  </div>
  <div class="flow" data-flow="main" data-region="column">
  {% for sn in s.order %}
    {% if sn == 'experience' and p.experience %}{{ sec('experience') }}
      {% for e in p.experience %}{% set P = 'experience.' ~ loop.index0 %}
      <div class="blk keep cv ent" data-group="sec_experience tbl_experience"><div class="l">{{ m.F(P~'.dates', e.dates) }}</div><div class="r"><div class="t1">{{ m.F(P~'.title', e.title) }}</div><div>{{ m.F(P~'.company', e.company) }}{% if s.show_loc %}<span class="sp">, </span>{{ m.F(P~'.location', e.location) }}{% endif %}</div></div></div>
      {% for b in e.bullets %}<div class="blk cv" data-group="sec_experience tbl_experience"><div class="l"></div><div class="r bl"><span class="bm">{{ s.bullet }}</span>{{ m.F(P~'.bullets.'~loop.index0, b) }}</div></div>{% endfor %}
      {% endfor %}
    {% elif sn == 'education' and p.education %}{{ sec('education') }}
      {% for e in p.education %}{% set P = 'education.' ~ loop.index0 %}
      <div class="blk cv ent" data-group="sec_education tbl_education"><div class="l">{{ m.F(P~'.dates', e.dates) }}</div><div class="r"><div class="t1">{{ m.F(P~'.degree', e.degree) }}</div><div>{{ m.F(P~'.institution', e.institution) }}{% if e.location and s.show_loc %}<span class="sp">, </span>{{ m.F(P~'.location', e.location) }}{% endif %}</div>{% if e.grade %}<div class="sm muted">{{ m.F(P~'.grade', e.grade) }}</div>{% endif %}</div></div>
      {% endfor %}
    {% elif sn == 'skills' and p.skills %}{{ sec('skills') }}
      {% for g in p.skill_groups %}<div class="blk cv" data-group="sec_skills tbl_skills"><div class="l" data-field="skill_group.{{ loop.index0 }}">{{ g.name }}</div><div class="r">{% for k in g.idx %}{{ m.F('skills.'~k, p.skills[k]) }}{% if not loop.last %}{{ s.skill_sep }}{% endif %}{% endfor %}</div></div>{% endfor %}
    {% elif sn == 'projects' and p.projects %}{{ sec('projects') }}
      {% for pr in p.projects %}{% set P = 'projects.' ~ loop.index0 %}
      <div class="blk cv ent" data-group="sec_projects tbl_projects"><div class="l">{% if pr.dates %}{{ m.F(P~'.dates', pr.dates) }}{% endif %}</div><div class="r"><div class="t1">{{ m.F(P~'.name', pr.name) }}</div><div>{{ m.F(P~'.description', pr.description) }}</div>{% if pr.tech %}<div class="sm muted">{{ s.tech_label }} {{ m.F(P~'.tech', pr.tech) }}</div>{% endif %}</div></div>
      {% endfor %}
    {% elif sn == 'certifications' and p.certifications %}{{ sec('certifications') }}
      {% for c in p.certifications %}{% set P = 'certifications.' ~ loop.index0 %}
      <div class="blk cv" data-group="sec_certifications tbl_certifications"><div class="l">{{ m.F(P~'.year', c.year) }}</div><div class="r">{{ m.F(P~'.name', c.name, 'b') }}<span class="sp">, </span>{{ m.F(P~'.issuer', c.issuer) }}</div></div>
      {% endfor %}
    {% elif sn == 'awards' and p.awards %}{{ sec('awards') }}
      {% for a in p.awards %}{% set P = 'awards.' ~ loop.index0 %}
      <div class="blk cv" data-group="sec_awards tbl_awards"><div class="l">{{ m.F(P~'.year', a.year) }}</div><div class="r">{{ m.F(P~'.name', a.name, 'b') }}{% if a.issuer %}<span class="sp">, </span>{{ m.F(P~'.issuer', a.issuer) }}{% endif %}</div></div>
      {% endfor %}
    {% elif sn == 'languages' and p.languages %}{{ sec('languages') }}
      {% for l in p.languages %}{% set P = 'languages.' ~ loop.index0 %}
      <div class="blk cv" data-group="sec_languages tbl_languages"><div class="l">{{ m.F(P~'.language', l.language) }}</div><div class="r">{{ m.F(P~'.proficiency', l.proficiency) }}</div></div>
      {% endfor %}
    {% endif %}
  {% endfor %}
  </div>
</div>
</body></html>
